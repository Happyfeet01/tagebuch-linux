{
	"name": "nextcloud/tagebuch",
	"description": "Privates Tagebuch als Markdown-Dateien in den Nextcloud-Dateien, mit E-Mail-Erinnerung und Mail-in",
	"license": "AGPL-3.0-or-later",
	"authors": [
		{
			"name": "Happyfeet01",
			"homepage": "https://github.com/Happyfeet01"
		}
	],
	"autoload": {
		"psr-4": {
			"OCA\\Tagebuch\\": "lib/"
		}
	},
	"scripts": {
		"lint": "find appinfo lib tests -name \\*.php -print0 | xargs -0 -n1 php -l",
		"test:unit": "phpunit -c tests/phpunit.xml --colors=always"
	},
	"require": {
		"php": "^8.1"
	},
	"require-dev": {
		"nextcloud/ocp": "dev-stable31",
		"phpunit/phpunit": "^11.5"
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.1"
		}
	}
}
